      "title": "Sports Report",
      "phrases": [
        {
          "text": "This morning the Roarers football team arrived back from York",
          "audio": "assets/Sports%20Report/01%20This%20morning%20the%20Roarers%20football%20team%20arrived%20back%20from%20York.mp3"
        },
        {
          "text": "Laura Short is our sports reporter and she was at the airport",
