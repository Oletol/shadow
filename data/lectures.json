        {
          "text": "Good morning, George",
          "audio": "assets/Sports%20Report/06%20Good%20morning%2C%20George.mp3"
        },
        {
          "text": "Good morning",
          "audio": "assets/Sports%20Report/07%20Good%20morning.mp3"
        },
        {
          "text": "Are you a reporter",
          "audio": "assets/Sports%20Report/08%20Are%20you%20a%20reporter.mp3"
        },
        {
          "text": "Yes, George",
          "audio": "assets/Sports%20Report/09%20Yes%2C%20George.mp3"
        },
        {
          "text": "I'm Laura Short from Radio Station 4",
          "audio": "assets/Sports%20Report/10%20I%27m%20Laura%20Short%20from%20Radio%20Station%204.mp3"
        },
        {
          "text": "Tell us about the football match with York",
