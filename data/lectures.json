        },
        {
          "text": "Whose fault was it George",
          "audio": "assets/Sports%20Report/16%20Whose%20fault%20was%20it%20George.mp3"
        },
        {
          "text": "The forwards",
          "audio": "assets/Sports%20Report/17%20The%20forwards.mp3"
        },
        {
          "text": "The forwards",
          "audio": "assets/Sports%20Report/18%20The%20forwards.mp3"
        },
        {
          "text": "Yes, the forwards",
          "audio": "assets/Sports%20Report/19%20Yes%2C%20the%20forwards.mp3"
        },
        {
          "text": "They're always falling over or losing the ball",
